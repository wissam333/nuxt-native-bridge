# Electron artifacts live on GitHub's release CDN, which times out on this
# network even when cached (the SHASUMS256.txt fetch is re-done every run).
# Same problem class as the Maven mirrors in the spec (§3 decision 9) — when
# `nnb` exists, the CLI should set this instead of a committed .npmrc.
electron_mirror=https://npmmirror.com/mirrors/electron/

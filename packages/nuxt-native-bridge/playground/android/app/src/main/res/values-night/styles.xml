<?xml version="1.0" encoding="utf-8" ?>
<resources>

    <!-- nnb:styles-night — dark resolution of the launch styles, rewritten by nnb sync -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0B1416</item>
        <item name="android:navigationBarColor">#0D8A8F</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash_dark</item>
        <item name="android:windowBackground">#0B1416</item>
        <item name="windowSplashScreenBackground">#0B1416</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>

{
  "name": "nuxt-native-bridge",
  "version": "0.1.2",
  "description": "One Nuxt codebase shipped as a website, a desktop app (Electron) and an Android app (Capacitor).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wissam333/nuxt-native-bridge.git"
  },
  "homepage": "https://github.com/wissam333/nuxt-native-bridge#readme",
  "bugs": {
    "url": "https://github.com/wissam333/nuxt-native-bridge/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "electron",
    "android",
    "capacitor",
    "desktop",
    "mobile",
    "spa"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
